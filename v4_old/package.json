    "oxfix:examples": "oxfmt dist/example/js/ --write"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "pinia": "^2.1.7",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.5.1",
    "vxe-pc-ui": "~4.17.21",
    "vxe-table": "~4.21.2",
    "xe-utils": "^4.0.11"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "~24.12.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "~6.0.8",
    "@vitejs/plugin-vue-jsx": "~5.1.6",
    "del": "~6.0.0",
    "eslint": "^10.8.1",
    "eslint-config-flat": "^1.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "gulp": "~5.0.1",
    "gulp-rename": "~2.1.0",
    "gulp-replace": "~1.1.4",
    "gulp-typescript": "~5.0.1",
    "oxfmt": "^0.51.0",
    "rollup-plugin-external-globals": "~0.13.0",
    "sass": "~1.101.7",
    "sass-loader": "~17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "~8.2.1",
    "vite-plugin-html": "~3.2.2",
    "vite-plugin-zip-pack": "~1.2.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.8"
