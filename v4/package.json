{
  "name": "vxe-table-v4",
  "version": "4.7.0",
  "private": true,
  "scripts": {
    "update": "pnpm install --no-frozen-lockfile",
    "serve": "vite",
    "build": "vue-tsc && vite build",
    "lint:es": "eslint src",
    "lint:ox": "oxfmt --check src/**",
    "esfix": "eslint --fix src",
    "oxfix": "oxfmt src/** --write",
    "pack": "npm run build && gulp build_examples && npm run oxfix:examples",
    "esfix:examples": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx,.vue dist/example/js/**",
    "oxfix:examples": "oxfmt dist/example/js/ --write"
  },
  "dependencies": {
    "@vxe-ui/plugin-render-chart": "^4.0.1",
    "axios": "~1.20.0",
    "core-js": "^3.8.3",
    "pinia": "^3.0.2",
    "vue": "3.5.16",
    "vue-i18n": "~11.3.0",
    "vue-router": "^4.5.1",
    "vxe-design": "~4.1.11",
    "vxe-pc-ui": "~4.20.34",
    "vxe-table": "~4.23.12",
    "xe-utils": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "~26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "~6.0.10",
    "@vitejs/plugin-vue-jsx": "~5.1.6",
    "del": "~6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-flat": "^1.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "gulp": "~5.0.1",
    "gulp-rename": "~2.1.0",
    "gulp-replace": "~1.1.4",
    "gulp-typescript": "~5.0.1",
    "oxfmt": "~0.51.0",
    "rollup-plugin-external-globals": "~0.13.0",
    "sass": "~1.106.0",
    "sass-loader": "~17.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "~8.3.4",
    "vite-plugin-html": "~3.2.2",
    "vite-plugin-zip-pack": "~1.2.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.13"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}